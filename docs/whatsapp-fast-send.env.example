# WhatsApp fast-send public URL configuration.
#
# Optional explicit public base URL used when Green API fetches a generated
# attachment. Leave unset to use Render's injected external URL or the
# forwarded request host.
# WHATSAPP_PUBLIC_BASE_URL=https://erp.example.com

# Render injects this automatically for hosted services. It is documented here
# because the fast-send fallback reads it directly; operators should not need to
# set it manually on Render.
# RENDER_EXTERNAL_URL=https://example.onrender.com
