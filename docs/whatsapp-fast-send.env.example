# WhatsApp fast-send public URL configuration.
#
# Fast sends let Green API fetch a short-lived generated PDF directly from the
# ERP instead of uploading the entire file through the application process.

# Optional explicit externally reachable base URL for the ERP. Prefer this when
# the public URL cannot be inferred reliably from proxy request headers.
# WHATSAPP_PUBLIC_BASE_URL=https://erp.example.com

# Render injects this with the service's externally reachable URL. The fast-send
# path uses it as a fallback when WHATSAPP_PUBLIC_BASE_URL is not set.
# RENDER_EXTERNAL_URL=
