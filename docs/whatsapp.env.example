# WhatsApp fast-send public URL configuration.
#
# Optional. When set, generated PDF/file sends use a short-lived public URL
# that the WhatsApp provider can fetch instead of uploading the whole file.
# Leave unset in local development; the server falls back to direct upload.
WHATSAPP_PUBLIC_BASE_URL=https://erp.example.com

# Render injects this automatically for deployed services. The server uses it
# as the public-base fallback when WHATSAPP_PUBLIC_BASE_URL is not configured.
# Operators normally do not set this manually outside Render.
RENDER_EXTERNAL_URL=https://example-service.onrender.com
