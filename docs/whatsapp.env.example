# WhatsApp fast-send public URL configuration.
#
# Optional override for the public HTTPS origin used when generated WhatsApp
# media/document links must be reachable from outside the ERP service.
# When unset, the server falls back to Render's injected external service URL.
WHATSAPP_PUBLIC_BASE_URL=

# Render injects this automatically for deployed web services. Do not set it
# manually on Render; it is documented here because the WhatsApp fast-send
# route uses it as the fallback public origin.
RENDER_EXTERNAL_URL=
