# Remote-support rollout configuration
#
# These values seed the production boot state. Runtime changes made through
# the guarded administrative API are transient; restarting the application
# restores this configured boot state.

# disabled | internal | canary | general
# Set explicitly to disabled for a fail-closed staged rollout.
REMOTE_SUPPORT_ROLLOUT_STAGE=disabled

# Comma-separated positive company IDs allowed during the canary stage.
REMOTE_SUPPORT_CANARY_COMPANY_IDS=

# Comma-separated controller user IDs allowed during the internal stage in
# addition to Developer-role controllers.
REMOTE_SUPPORT_INTERNAL_CONTROLLER_USER_IDS=
