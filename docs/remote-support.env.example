# Remote support production controls
#
# These variables are optional. Production defaults keep remote control and
# keyboard control enabled unless explicitly set to "false". Non-production
# environments keep rollout state disabled regardless of these values.

# Set to "false" to disable remote mouse/control sessions in production while
# keeping passive screen viewing available.                  (default: enabled)
# REMOTE_SUPPORT_REMOTE_CONTROL=true

# Set to "false" to disable remote keyboard control while leaving remote mouse
# control available. Ignored when REMOTE_SUPPORT_REMOTE_CONTROL is false.
#                                                            (default: enabled)
# REMOTE_SUPPORT_KEYBOARD_CONTROL=true

# disabled | internal | canary | general. Production defaults to general;
# non-production environments always boot disabled.          (default: general)
# REMOTE_SUPPORT_ROLLOUT_STAGE=general

# Comma-separated positive company IDs eligible during the canary stage.
# Required only when REMOTE_SUPPORT_ROLLOUT_STAGE=canary.
# REMOTE_SUPPORT_CANARY_COMPANY_IDS=

# Comma-separated user IDs eligible to control sessions during internal rollout.
# Required only when REMOTE_SUPPORT_ROLLOUT_STAGE=internal.
# REMOTE_SUPPORT_INTERNAL_CONTROLLER_USER_IDS=
