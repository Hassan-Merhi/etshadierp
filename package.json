{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --import ./server/exportBufferBridge.mjs --import ./server/scheduledAttachmentBridge.mjs --import ./server/apiPaginationBridge.mjs ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "prebuild": "node -e \"require.resolve('vite'); require.resolve('esbuild'); console.log('Build dependencies OK')\" && node scripts/verify-lockfile-registry.mjs",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build && node scripts/build-server.mjs && node scripts/verify-server-bundle.mjs",
    "verify:lockfile": "node scripts/verify-lockfile-registry.mjs",
    "verify:server-bundle": "node scripts/verify-server-bundle.mjs",
    "verify:production-dependencies": "node scripts/verify-production-dependencies.mjs",
    "verify:stabilization": "node scripts/verify-memory-stabilization.mjs",
    "audit:exports": "node scripts/audit-large-export-buffers.mjs",
    "audit:heavy-apis": "node scripts/audit-heavy-list-endpoints.mjs",
    "audit:program-6c": "node scripts/run-program6c-inventory-review.mjs",
    "audit:program-6c:stock-items": "node scripts/audit-program6c-stock-item-callers.mjs --json",
    "audit:program-6c:inventory-payloads": "node scripts/audit-program6c-inventory-payloads.mjs --json",
    "audit:program-6c:validate": "node scripts/validate-program6c-inventory-classifications.mjs",
    "audit:program-6d": "node scripts/audit-program6d-database-query-risks.mjs --json",
    "audit:program-6d:review": "node scripts/run-program6d-query-review.mjs",
    "audit:program-6d:validate": "node scripts/validate-program6d-query-classifications.mjs",
    "start": "node --expose-gc --import ./server/exportBufferBridge.mjs --import ./server/scheduledAttachmentBridge.mjs --import ./server/apiPaginationBridge.mjs --import ./server/runtimeMemoryGuard.mjs dist/index.js",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "check:program-6-security": "node scripts/run-program-6-focused-security-checks.mjs",
    "db:push": "drizzle-kit push",
    "build:cap": "vite build --mode production",
    "cap:sync": "npm run build:cap && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "test": "node node_modules/vitest/vitest.mjs run && node node_modules/vitest/vitest.mjs run --config vitest.config.frontend.ts",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js \"client/src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"shared/**/*.ts\"",
    "lint:fix": "node node_modules/eslint/bin/eslint.js \"client/src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"shared/**/*.ts\" --fix",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"client/src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"shared/**/*.ts\"",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"client/src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"shared/**/*.ts\"",
    "test:backend": "node node_modules/vitest/vitest.mjs run",
    "test:backend:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:frontend": "node node_modules/vitest/vitest.mjs run --config vitest.config.frontend.ts",
    "test:frontend:coverage": "node node_modules/vitest/vitest.mjs run --config vitest.config.frontend.ts --coverage"
  },
