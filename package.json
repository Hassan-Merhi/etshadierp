  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "dev": "node --import ./server/factoryContainerSchemaBridge.mjs --import ./server/supplierCompanyScopeBridge.mjs --import ./server/exportBufferBridge.mjs --import ./server/scheduledAttachmentBridge.mjs --import ./server/apiPaginationBridge.mjs ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "prebuild": "node -e \"require.resolve('vite'); require.resolve('esbuild'); console.log('Build dependencies OK')\" && node scripts/verify-lockfile-registry.mjs",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build && node scripts/build-server.mjs && node scripts/verify-server-bundle.mjs && node scripts/verify-runtime-dependencies.mjs",
    "verify:lockfile": "node scripts/verify-lockfile-registry.mjs",
    "verify:dependency-audit": "node scripts/verify-dependency-audit.mjs",
    "verify:env-docs": "node scripts/verify-env-documentation.mjs",
    "verify:migrations": "node scripts/verify-migration-registry.mjs",
    "verify:startup-migrations": "node scripts/verify-startup-migrations.mjs",
    "verify:server-bundle": "node scripts/verify-server-bundle.mjs",
    "verify:runtime-dependencies": "node scripts/verify-runtime-dependencies.mjs",
    "verify:production-dependencies": "node scripts/verify-production-dependencies.mjs",
    "verify:final-production-readiness": "node scripts/verify-final-production-readiness.mjs",
    "verify:observability": "node scripts/verify-program1-observability-foundation.mjs",
    "verify:stabilization": "node scripts/verify-memory-stabilization.mjs",
    "verify:mobile-web-routing": "node scripts/verify-mobile-web-routing.mjs",
    "verify:bandwidth": "node scripts/verify-bandwidth-phases-1-2.mjs",
    "smoke:bandwidth": "node scripts/run-bandwidth-production-smoke.mjs",
    "audit:exports": "node scripts/audit-large-export-buffers.mjs",
    "audit:heavy-apis": "node scripts/audit-heavy-list-endpoints.mjs",
    "audit:inventory-contracts": "node scripts/run-program6c-inventory-review.mjs",
    "audit:inventory-contracts:stock-item-callers": "node scripts/audit-program6c-stock-item-callers.mjs --json",
    "audit:inventory-contracts:payloads": "node scripts/audit-program6c-inventory-payloads.mjs --json",
    "audit:inventory-contracts:validate": "node scripts/validate-program6c-inventory-classifications.mjs",
    "audit:query-risks": "node scripts/audit-program6d-database-query-risks.mjs --json",
    "audit:query-risks:review": "node scripts/run-program6d-query-review.mjs",
    "audit:query-risks:validate": "node scripts/validate-program6d-query-classifications.mjs",
    "audit:source-text-assertions": "node scripts/audit-source-text-assertions.mjs",
    "audit:god-files": "node scripts/audit-god-file-boundaries.mjs",
    "audit:type-escapes": "node scripts/audit-type-escapes.mjs",
    "audit:doc-index": "node scripts/audit-doc-index.mjs",
    "audit:write-routes": "node scripts/audit-write-route-coverage.mjs",
    "audit:write-evidence": "node scripts/audit-write-evidence.mjs",
    "audit:toolchain": "node scripts/audit-toolchain-coherence.mjs",
    "audit:scripts": "node scripts/audit-script-inventory.mjs",
    "audit:company-scope": "node scripts/audit-company-scope.mjs",
    "audit:coverage-ratchet": "node scripts/audit-coverage-ratchet.mjs",
    "audit:lint-ratchet": "node scripts/audit-lint-warnings.mjs",
    "audit:ux-consistency": "node scripts/audit-ux-module-consistency.mjs",
    "start": "node --expose-gc --import ./server/factoryContainerSchemaBridge.mjs --import ./server/supplierCompanyScopeBridge.mjs --import ./server/exportBufferBridge.mjs --import ./server/scheduledAttachmentBridge.mjs --import ./server/apiPaginationBridge.mjs --import ./server/runtimeMemoryGuard.mjs dist/index.js",
    "check": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "check:security": "node scripts/run-program-6-focused-security-checks.mjs",
    "db:push": "drizzle-kit push",
    "build:cap": "vite build --mode capacitor",
    "cap:sync": "npm run build:cap && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "test": "node node_modules/vitest/vitest.mjs run && node node_modules/vitest/vitest.mjs run --config vitest.config.frontend.ts",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "lint": "node --max-old-space-size=6144 scripts/run-lint.mjs",
    "lint:fix": "node node_modules/eslint/bin/eslint.js \"client/src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"shared/**/*.ts\" --fix",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"client/src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"shared/**/*.ts\"",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"client/src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"shared/**/*.ts\"",
    "format:check:changed": "node scripts/check-changed-file-formatting.mjs",
    "test:backend": "node node_modules/vitest/vitest.mjs run",
    "test:smoke-sweep": "node node_modules/vitest/vitest.mjs run --config vitest.config.smoke-sweep.ts",
    "test:backend:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:backend:verify": "node scripts/run-backend-verification.mjs --complete",
    "test:backend:verify:coverage": "node scripts/run-backend-verification.mjs --coverage",
    "test:frontend": "node node_modules/vitest/vitest.mjs run --config vitest.config.frontend.ts",
    "test:frontend:coverage": "node node_modules/vitest/vitest.mjs run --config vitest.config.frontend.ts --coverage"
  },
