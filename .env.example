# Database Configuration
# PostgreSQL connection string (required)
# Example: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/erp_db

# Session Configuration
# Secret key for session encryption (required in production)
# Generate a strong random string for production
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Application Configuration
# Environment: development or production
NODE_ENV=development

# Server Port
# Port on which the application runs (default: 5000)
PORT=5000

# Release identity (set only for a frozen manual production deployment)
# Must be the exact full 40-character commit SHA approved for release.
# RELEASE_EXPECTED_COMMIT=1234567890abcdef1234567890abcdef12345678
# Optional operator-selected identifier exposed by health endpoints.
# RELEASE_ID=erp-2026-07-30

# Dangerous controls are intentionally absent from the normal environment file.
# Do not persist migration confirmation, Historical Replay Apply, or master-password
# impersonation settings as ordinary deployment configuration.
