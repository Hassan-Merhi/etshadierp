{
  "version": 1,
  "description": "State index for docs/. Every doc is classified as \"reference\" (describes current behaviour, must stay accurate) or \"record\" (describes finished work, correct as history) — an unclassified doc fails the audit, so the choice is made when the doc is written. The classification was seeded by filename heuristic and is reviewed in Phase 3a of docs/system-quality-program.md; it is data for that review, not an assertion. figures[] binds documented numbers to their live source so a doc that drifts from the config it describes fails instead of quietly misleading.",
  "scan": {
    "root": "docs",
    "extensions": [
      ".md"
    ],
    "excludeDirectories": [
      "node_modules"
    ]
  },
  "figures": [
    {
      "id": "godFileBacklogFiles",
      "description": "Files still over the 900-line repository limit.",
      "source": {
        "kind": "auditSummary",
        "audit": "god-files",
        "field": "grandfatheredFiles"
      },
      "claims": [
        {
          "doc": "docs/god-file-split-program.md",
          "pattern": "\\*\\*Backlog: ([\\d,]+) files"
        },
        {
          "doc": "docs/system-quality-program.md",
          "pattern": "God-file backlog \\| ([\\d,]+) files"
        }
      ]
    },
    {
      "id": "godFileBacklogExcessLines",
      "description": "Lines carried above the repository limit by grandfathered files.",
      "source": {
        "kind": "auditSummary",
        "audit": "god-files",
        "field": "grandfatheredExcessLines"
      },
      "claims": [
        {
          "doc": "docs/god-file-split-program.md",
          "pattern": "\\*\\*Backlog: [\\d,]+ files, ([\\d,]+) lines over the limit\\*\\*"
        },
        {
          "doc": "docs/system-quality-program.md",
          "pattern": "God-file backlog \\| [\\d,]+ files, ([\\d,]+) excess lines"
        }
      ]
    },
    {
      "id": "typeEscapeCeiling",
      "description": "Repository-wide type-escape ceiling; may only fall.",
      "source": {
        "kind": "jsonValue",
        "file": "config/type-escape-boundaries.json",
        "path": "totals.typeEscapeCeiling"
      },
      "claims": [
        {
          "doc": "docs/system-quality-program.md",
          "pattern": "Type escapes \\(AST\\) \\| ([\\d,]+) total"
        }
      ]
    },
    {
      "id": "backendCoverageLinesFloor",
      "description": "Global backend line-coverage floor enforced by vitest.config.ts.",
      "source": {
        "kind": "jsonValue",
        "file": "config/coverage-thresholds.json",
        "path": "backend.global.lines"
      },
      "claims": [
        {
          "doc": "docs/system-quality-program.md",
          "pattern": "Backend coverage floor \\(lines\\) \\| ([\\d,]+)%"
        }
      ]
    },
    {
      "id": "routeManifestRouteCount",
      "description": "Registered Express routes in the committed manifest.",
      "source": {
        "kind": "jsonValue",
        "file": "config/route-manifest.json",
        "path": "routeCount"
      },
      "claims": [
        {
          "doc": "docs/system-quality-program.md",
          "pattern": "Registered routes \\| ([\\d,]+)"
        }
      ]
    }
  ],
  "classification": {
