{
  "version": 21,
  "description": "Repository-wide god-file architecture boundaries plus a one-way size ratchet. Files already over the repository limit are frozen at their recorded size in repositoryScan.grandfathered: they may shrink but never grow, and any new file crossing the limit fails until it is split or explicitly baselined. Version 21 permanently retires StockAdjustmentForm.tsx after its behavior-preserving Wave 6 split into a typed model, typed view, and stable original-path composition shell, with every authored replacement file below the 900-line repository limit.",
  "retiredFiles": [
    "server/routesLegacy.ts",
    "server/routes/reportsRoutesLegacy.ts",
    "server/routes/authRoutesLegacy.ts",
    "server/routes/customerRoutesLegacy.ts"
  ],
  "boundedFiles": [
    {
      "path": "server/routes.ts",
      "owner": "Public route entry point",
      "maxLines": 30,
      "forbidPatterns": [
        "app.get(",
        "app.post(",
        "app.put(",
        "app.patch(",
        "app.delete(",
        "app.use("
      ]
    },
    {
      "path": "server/routes/applicationRoutes.ts",
      "owner": "Application route composition",
      "maxLines": 220,
      "forbidPatterns": [
        "app.get(",
        "app.post(",
        "app.put(",
        "app.patch(",
        "app.delete("
      ]
    },
    {
      "path": "server/storage/factory.ts",
      "owner": "Factory storage compatibility barrel",
      "maxLines": 10,
      "forbidPatterns": [
        "drizzle-orm",
        "../db",
        "db.select(",
        "db.insert(",
        "db.update(",
        "db.delete("
      ]
    },
    {
      "path": "server/storage/pos.ts",
      "owner": "POS storage compatibility barrel",
      "maxLines": 10,
      "forbidPatterns": [
        "drizzle-orm",
        "../db",
        "db.select(",
        "db.insert(",
        "db.update(",
        "db.delete("
      ]
    },
    {
      "path": "client/src/app/AuthenticatedApp.tsx",
      "owner": "Authenticated shell orchestration",
      "maxLines": 150,
      "forbidPatterns": [
        "useQuery<",
        "fetch(\"/api/",
        "SUPPLIER_PARTNER_PATHS",
        "computeFactoryGuardRedirect("
      ]
    },
    {
      "path": "server/routes/debugRoutes.ts",
      "owner": "Debug route composition",
      "maxLines": 20,
      "forbidPatterns": [
        "app.get(",
        "app.post(",
        "app.put(",
        "app.patch(",
        "app.delete(",
        "drizzle-orm",
        "@shared/schema",
        "../db"
      ]
    },
    {
      "path": "server/routes/debug/importCycleDiagnosticFoundation.ts",
      "owner": "Import-cycle diagnostic data collection",
      "maxLines": 650,
      "forbidPatterns": [
        "app.get(",
        "app.post(",
        "res.json("
      ]
    },
    {
      "path": "server/routes/debug/importCycleDiagnosticAnalysis.ts",
      "owner": "Import-cycle reconciliation and response assembly",
      "maxLines": 700,
      "forbidPatterns": [
        "app.get(",
        "app.post(",
        "requireAuth",
        "requireRole"
      ]
    }
  ],
  "repositoryScan": {
    "roots": [
      "server",
      "client/src",
      "shared",
      "scripts",
      "tests"
    ],
    "extensions": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".mjs",
      ".cjs"
    ],
    "softMaxLines": 900,
    "ratchetBucketLines": 25,
    "excludeDirectories": [
      "node_modules",
      "dist",
      "build",
      "coverage",
      ".git",
      "migrations"
    ],
    "excludeFiles": [
